# OpenAI配置
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
DEFAULT_MODEL=gpt-3.5-turbo

# 目录配置
INPUT_DIR=/path/to/your/input/directory  # 要分析的目录
OUTPUT_DIR=/path/to/your/output/directory  # 文档输出目录

# 其他配置
IGNORE_DIRS=node_modules,.git,__pycache__,venv  # 要忽略的目录，用逗号分隔
IGNORE_FILES=.DS_Store  # 要忽略的文件，用逗号分隔